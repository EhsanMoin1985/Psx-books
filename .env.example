# Supabase. Without these two the app runs on psx-books-data.json and says so
# on screen; nothing typed into it is kept.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Needed only by `npm run seed` and by the cron job when it
# writes prices without a signed-in session. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=

# Shared secret for the scheduled price refresh. Set it in Vercel and the cron
# job's Authorization header is checked against it.
CRON_SECRET=

# Alert email, through Resend.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# A licensed market data vendor, if one is chosen. Leave blank and the price
# source falls back to the manual paste on the settings page. Do not point
# this at the PSX portal: PSX licenses its data and prohibits redistribution.
PRICE_VENDOR_NAME=
PRICE_VENDOR_URL=
PRICE_VENDOR_KEY=
